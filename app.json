{
  "expo": {
    "name": "MY VIDYON",
    "slug": "my-vidyon-rebuild",
    "scheme": "myvidyonrebuild",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.myvidyon.app",
      "googleServicesFile": "./google-services.json",
      "notification": {
        "icon": "./assets/android-icon-monochrome.png",
        "color": "#1E3A8A"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-secure-store",
      "expo-notifications",
      "@react-native-community/datetimepicker",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-8782577961794696~4810132296",
          "iosAppId": "ca-app-pub-8782577961794696~4810132296"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e43bedd5-6bcc-4eeb-9a4b-4588ac9d04aa"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e43bedd5-6bcc-4eeb-9a4b-4588ac9d04aa"
    }
  }
}
