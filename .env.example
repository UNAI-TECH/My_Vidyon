# ============================================================
# My Vidyon ERP - Environment Configuration Template
# NOTE: Replace placeholder values with environment-specific secrets.
# NEVER commit populated .env files to version control!
# ============================================================

# Supabase Backend Configuration
VITE_SUPABASE_PROJECT_ID=your-project-ref-here
VITE_SUPABASE_URL=https://your-project-ref-here.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key-here

# Supabase Service Role Key (Server-Side / Edge Function / Admin CLI Only)
# CAUTION: Never expose this key in public client bundles!
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Optional Camera Surveillance Stream (RTSP format)
CAMERA_RTSP_URL=rtsp://username:password@127.0.0.1:554/live/ch0
