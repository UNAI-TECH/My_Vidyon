# ============================================================
# My Vidyon ERP - Environment Configuration Template
# NOTE: Replace placeholder values with environment-specific secrets.
# NEVER commit populated .env files to version control!
# ============================================================

# Supabase Backend Configuration (Expo Client)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref-here.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-public-anon-key-here
EXPO_PUBLIC_SUPABASE_PROJECT_ID=your-project-ref-here

# Legacy / Vite Compatibility
VITE_SUPABASE_PROJECT_ID=your-project-ref-here
VITE_SUPABASE_URL=https://your-project-ref-here.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key-here

# Supabase Service Role Key (Server-Side / Edge Function / Admin CLI Only)
# CAUTION: Never expose this key in public client bundles!
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Optional Camera Surveillance Stream (RTSP format)
CAMERA_RTSP_URL=rtsp://username:password@127.0.0.1:554/live/ch0

# ============================================================
# Firebase Web App Config (Electron / Web push notifications)
# Get these from: Firebase Console → Project Settings → General → Your apps → Web App
# ============================================================
EXPO_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
EXPO_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# VAPID Key — Firebase Console → Project Settings → Cloud Messaging → Web Push certificates → Key pair
EXPO_PUBLIC_FIREBASE_VAPID_KEY=your-vapid-key-here
